{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FYPMS create_model prompt",
  "type": "object",
  "required": ["task", "model", "collection", "description", "fields", "access"],
  "additionalProperties": false,
  "properties": {
    "task": { "const": "create_model" },
    "model": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]+$" },
    "collection": { "type": "string", "pattern": "^[a-z0-9_{}/]+$" },
    "description": { "type": "string", "minLength": 5 },
    "doc_id": { "type": "string", "pattern": "^(auto|field:[a-z_]+|deterministic:.+)$", "default": "auto" },
    "course_scoped": { "type": "boolean", "default": false },
    "timestamps": { "type": "boolean", "default": true },
    "audit": { "type": "boolean", "default": true },
    "owner_field": { "type": ["string", "null"] },
    "fields": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "type"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "type": { "enum": ["string", "number", "integer", "boolean", "timestamp", "enum", "string_array", "map", "ref"] },
          "required": { "type": "boolean", "default": false },
          "values": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "ref": { "type": "string" },
          "min": { "type": "number" },
          "max": { "type": "number" },
          "default": {},
          "index": { "type": "boolean" },
          "unique": { "type": "boolean" },
          "sensitive": { "type": "boolean" },
          "writable_by_client": { "type": "boolean", "default": false },
          "description": { "type": "string" }
        }
      }
    },
    "access": {
      "type": "object",
      "required": ["read", "create", "update", "delete"],
      "additionalProperties": false,
      "properties": {
        "read": { "$ref": "#/$defs/access" },
        "create": { "$ref": "#/$defs/access" },
        "update": { "$ref": "#/$defs/access" },
        "delete": { "$ref": "#/$defs/access" }
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "roles"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
          "roles": { "type": "array", "items": { "enum": ["student", "supervisor", "coordinator", "admin", "panel_member"] }, "minItems": 1 },
          "description": { "type": "string" }
        }
      }
    },
    "queries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["where"],
        "properties": {
          "where": { "type": "array", "items": { "type": "array", "minItems": 2, "maxItems": 2 } },
          "orderBy": { "type": "string", "pattern": "^[a-z_]+( (asc|desc))?$" },
          "limit": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "generate": {
      "type": "array",
      "items": { "enum": ["types", "zod", "repo", "rules", "indexes", "actions", "tests", "registry"] }
    }
  },
  "$defs": {
    "access": {
      "oneOf": [
        { "enum": ["server", "none"] },
        {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["student", "supervisor", "coordinator", "admin", "panel_member", "any_member", "owner", "team_members", "assigned_supervisor"] }
        }
      ]
    }
  }
}
