# ==============================================================================
# FYPMS Environment Configuration (.env.example)
# Copy this file to .env.local for local development or configure in Vercel.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Public Firebase Client SDK (Safe for browser bundle)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

# Set to "true" ONLY when running against local Firebase Auth & Firestore emulators
NEXT_PUBLIC_USE_FIREBASE_EMULATORS="false"
NEXT_PUBLIC_USE_EMULATORS="false"

# ------------------------------------------------------------------------------
# 2. Firebase Admin SDK (Server-Only — NEVER prefix with NEXT_PUBLIC_)
# ------------------------------------------------------------------------------
FIREBASE_ADMIN_PROJECT_ID=""
FIREBASE_ADMIN_CLIENT_EMAIL=""
# Wrap in double quotes and keep literal \n characters for private key newlines
FIREBASE_ADMIN_PRIVATE_KEY=""

# ------------------------------------------------------------------------------
# 3. Optional Local Emulator Hosts (set automatically by dev:emulators / test scripts)
# ------------------------------------------------------------------------------
# Dev emulator ports (firebase.json / project: demo-fypms)
# FIREBASE_AUTH_EMULATOR_HOST="127.0.0.1:9099"
# FIRESTORE_EMULATOR_HOST="127.0.0.1:8080"
# NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST="http://127.0.0.1:9099"
# NEXT_PUBLIC_FIRESTORE_EMULATOR_HOST="127.0.0.1:8080"
